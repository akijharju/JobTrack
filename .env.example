# Development MariaDB container settings.
# Copy this template to .env; never place real passwords in this tracked file.
MARIADB_VERSION=11.8
DB_NAME=jobtrack
DB_USER=appuser

# Publish the database port only on the local development machine.
DB_HOST=127.0.0.1
DB_PORT=3306

# Set two different passwords only in the local .env file.
# Reserved for database administration; the application pool does not use this account.
DB_ROOT_PASSWORD=
# Used by the application account identified by DB_USER.
DB_PASSWORD=

# Generate the signing key locally. Never commit the real key.
JWT_SECRET=
# Token lifetime in seconds.
JWT_TTL_SECONDS=3600
