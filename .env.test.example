# Settings for the separate test environment.
NODE_ENV=test
MARIADB_VERSION=11.8

# Use a separate port and database account for tests.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=jobtrack_test
DB_USER=jobtrack_test

# Generate these values only in the local .env.test file.
DB_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
JWT_TTL_SECONDS=3600