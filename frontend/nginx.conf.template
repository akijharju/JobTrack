server {
    listen 80;
    server_name _;

    # Serve the production files copied from the React build.
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        # Keep the original API path when forwarding the request.
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;

        # Forward the original host and connection information.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # Let React handle application paths that are not static files.
        try_files $uri $uri/ /index.html;
    }
}